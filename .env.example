# File di esempio: copialo in .env (`cp .env.example .env`) e sostituisci i valori.
# Quelli qui sotto sono segnaposto — il nome della variabile in minuscolo — non
# configurazioni reali: servono solo a mostrare quali chiavi esistono e in che
# formato. I default veri per la VM li propone `scripts/edit-env.sh`.

# Shared / production-like configuration
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db

# Directory dell'host in cui finiscono gli archivi di backup: percorso assoluto,
# montato dal compose su /app/backups.
BACKUP_HOST_DIR=/path/to/backup_host_dir

# Public hostname served through Cloudflare Tunnel. Set by scripts/install-tunnel.sh,
# which also creates the DNS record; the app itself never reads it, so changing domain
# means re-running that script, not rebuilding.
PUBLIC_DOMAIN=

# Dati del laboratorio mostrati in intestazioni, PDF ed email.
LAB_NAME=lab_name
LAB_EMAIL=lab_email@example.com
LAB_ADDRESS=lab_address
LAB_PHONE=+00 000 000 0000
LAB_LOGO_TEXT=lab_logo_text
# Percorso servito dal backend: lascialo così se usi il logo caricato da Impostazioni.
LAB_LOGO_URL=/assets/logo.jpg

# Development-only notes:
# docker-compose.dev.yml already injects the frontend VITE_* values.
# If you run frontend outside Docker, you can use:
# VITE_API_URL=http://localhost:3000/api
# VITE_LOGO_URL=http://localhost:3000/assets/logo.jpg
