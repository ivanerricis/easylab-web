# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Build outputs
dist/
build/
coverage/
backend/dist/
frontend/dist/
site/

# Vite
frontend/vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# Databases / local dev data
*.db
backend/data/
backend/backups/
# Scritta a runtime da updateManager per chiedere all'host un controllo aggiornamenti.
backend/update-signal/
ops/update/
# Stato dell'aggiornamento, scritto da root sull'host (scripts/update-status-lib.sh).
ops/update-status/

# Credenziali del tunnel Cloudflare (cert.pem + <tunnel>.json): sono segreti della VM,
# generati da scripts/install-tunnel.sh. Chi le ottiene può pubblicare sul dominio.
ops/cloudflared/

# Certificati di prova di Mailpit (scripts/dev/mailpit-cert.sh): chiavi di prova, ma pur sempre chiavi.
scripts/dev/certs/

# Roba di Claude Code: permessi della singola postazione (settings.local.json) e skill
# installate lì dentro, che possono pesare decine di MB. È configurazione di chi lavora,
# non del progetto: se un giorno serve condividere una skill o un comando col repo, va
# tolta l'esclusione per quel percorso specifico.
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
