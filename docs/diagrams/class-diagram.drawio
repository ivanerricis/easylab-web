="70" width="290" height="20" as="geometry"/></mxCell><mxCell id="r147" value="+ notified_at: datetime [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c143"><mxGeometry y="90" width="290" height="20" as="geometry"/></mxCell><mxCell id="c148" value="«enumeration»&lt;br&gt;&lt;b&gt;AlertKind&lt;/b&gt;" style="swimlane;html=1;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1580" width="290" height="92" as="geometry"/></mxCell><mxCell id="r149" value="warning" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c148"><mxGeometry y="44" width="290" height="20" as="geometry"/></mxCell><mxCell id="r150" value="exhausted" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c148"><mxGeometry y="64" width="290" height="20" as="geometry"/></mxCell><mxCell id="n151" value="&lt;b&gt;Pacchetti di assistenza (ore al mese)&lt;/b&gt;&lt;br&gt;{assistance_type → included_hours ammesse → interventi che le scalano}&lt;br&gt;• remote → 5, 10, 20 → remote&lt;br&gt;• on_site → 10, 20, 30 → customer_site, lab&lt;br&gt;• complete → 100 → remote, customer_site, lab&lt;br&gt;• full_time → NULL (illimitate) → remote, customer_site, lab&lt;br&gt;&lt;br&gt;&lt;b&gt;Ore del mese&lt;/b&gt; (mese di calendario, senza riporto)&lt;br&gt;/used_hours_month = somma (end_time − start_time) degli interventi&lt;br&gt;&lt;i&gt;completed&lt;/i&gt; collegati, con intervention_date nel mese.&lt;br&gt;/remaining_hours_month = included_hours − used_hours_month&lt;br&gt;&lt;br&gt;&lt;b&gt;Email al provider&lt;/b&gt;, una volta per mese ciascuna&lt;br&gt;(una riga in AssistanceHoursAlert per contratto, mese e tipo):&lt;br&gt;• warning quando used ≥ 80% di included_hours&lt;br&gt;• exhausted quando used ≥ 100%&lt;br&gt;Se le ore tornano sotto soglia la riga si cancella (riarmo).&lt;br&gt;full_time: nessun avviso.&lt;br&gt;&lt;br&gt;&lt;b&gt;Contratto&lt;/b&gt;&lt;br&gt;/end_date = start_date + term&lt;br&gt;{expired derivato: active e oggi ≥ end_date, non salvato}&lt;br&gt;{intervention.customer_id = contract.customer_id}&lt;br&gt;{intervention.type compatibile con assistance_type}&lt;br&gt;{contratto active e start_date ≤ intervention_date &lt; end_date}" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="1160" width="420" height="420" as="geometry"/></mxCell><mxCell id="c152" value="User" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1580" y="40" width="290" height="258" as="geometry"/></mxCell><mxCell id="r153" value="+ id: int PK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="c152"><mxGeometry y="30" width="290" height="20" as="geometry"/></mxCell><mxCell id="r154" value="+ username: text UQ [1]" style="text;html=1;strokeColor=none;fillColor=none