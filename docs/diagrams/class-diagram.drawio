&quot;&gt;FK&lt;/font&gt; [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="c173"><mxGeometry y="30" width="290" height="20" as="geometry"/></mxCell><mxCell id="r175" value="+ month: date PK [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="c173"><mxGeometry y="50" width="290" height="20" as="geometry"/></mxCell><mxCell id="r176" value="+ kind: AlertKind PK [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="c173"><mxGeometry y="70" width="290" height="20" as="geometry"/></mxCell><mxCell id="r177" value="+ notified_at: datetime [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c173"><mxGeometry y="90" width="290" height="20" as="geometry"/></mxCell><mxCell id="c178" value="«enumeration»&lt;br&gt;&lt;b&gt;AlertKind&lt;/b&gt;" style="swimlane;html=1;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1580" width="290" height="92" as="geometry"/></mxCell><mxCell id="r179" value="warning" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c178"><mxGeometry y="44" width="290" height="20" as="geometry"/></mxCell><mxCell id="r180" value="exhausted" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c178"><mxGeometry y="64" width="290" height="20" as="geometry"/></mxCell><mxCell id="n181" value="&lt;b&gt;Pacchetti di assistenza&lt;/b&gt; (listino nel codice, IVA esclusa)&lt;br&gt;{package → ore → prezzo → priorità → interventi che le scalano}&lt;br&gt;• remote_20 → 20 h/mese → 400 € → 4 → remote&lt;br&gt;• remote_40 → 40 h/mese → 720 € → 4 → remote&lt;br&gt;• ready_20 → 20 h/mese → 500 € → 3 → remote, customer_site, lab&lt;br&gt;• ready_40 → 40 h/mese → 900 € → 3 → idem&lt;br&gt;• ready_60 → 60 h/mese → 1.230 € → 3 → idem&lt;br&gt;• support_base → 80 h nei 12 mesi → 1.600 € → 2 → idem&lt;br&gt;• support_plus → 150 h nei 12 mesi → 2.500 € → 1 → idem&lt;br&gt;included_hours e price_cents sono una copia del listino, scritta dal&lt;br&gt;server alla creazione e a ogni cambio di pacchetto (nessun CHECK).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ore usate&lt;/b&gt;&lt;br&gt;/used_hours = somma (end_time − start_time) degli interventi&lt;br&gt;&lt;i&gt;completed&lt;/i&gt; collegati e coperti dal pacchetto:&lt;br&gt;• remote e ready: nel mese di calendario, senza riporto&lt;br&gt;• support: su tutto il contratto&lt;br&gt;/remaining_hours = included_hours − used_hours (anche negativo)&lt;br&gt;&lt;br&gt;&lt;b&gt;Email al provider&lt;/b&gt;, una volta per periodo ciascuna&lt;br&gt;(una riga in AssistanceHoursAlert per contratto, periodo e tipo;&lt;br&gt;periodo = mese; per support il mese di start_date):&lt;br&gt;• warning quando used ≥ 80% di included_hours&lt;br&gt;• exhausted quando used ≥ 100%&lt;br&gt;Se le ore tornano sotto soglia la riga si cancella (riarmo);&lt;br&gt;cambiando pacchetto si cancellano tutte le righe del contratto.&lt;br&gt;&lt;br&gt;&lt;b&gt;Contratto&lt;/b&gt;&lt;br&gt;/end_date = start_date + term_months&lt;br&gt;{expired derivato: active e oggi ≥ end_date, non salvato}&lt;br&gt;{intervention.customer_id = contract.customer_id}&lt;br&gt;{intervention.customer_device_id: solo se c'è il contratto,&lt;br&gt; e uno dei suoi dispositivi (contract_device)}&lt;br&gt;{intervention.type compatibile con package}&lt;br&gt;{contratto active e start_date ≤ intervention_date &lt; end_date}&lt;br&gt;{package support_*: term_months = 12}" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="1160" width="420" height="500" as="geometry"/></mxCell><mxCell id="c182" value="User" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1580" y="40" width="290" height="258" as="geometry"/></mxCell><mxCell id="r183" value="+ id: int PK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#1f5fbf;fontStyle=1;" vertex="1" parent="c182"><mxGeometry y="30" width="290" height="20" as="geometry"/></mxCell><mxCell id="r184" value="+ username: text UQ [1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c182"><mxGeometry y="50" width="290" height="20" as="geometry"/></mxCell><mxCell id="r185" v